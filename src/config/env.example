# Supabase project URL (no /rest/v1)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon / publishable key (safe to expose to frontend, still keep in env)
SUPABASE_ANON_KEY=sb_publishable_your_key_here

# OpenAI API key (never commit real keys)
OPENAI_API_KEY=your_openai_api_key_here

# Optional port for local Express preview server
PORT=4000
